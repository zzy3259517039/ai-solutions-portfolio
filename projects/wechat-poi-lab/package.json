{
  "name": "wechat-poi-lab",
  "private": true,
  "version": "0.1.0",
  "description": "微信 POI 接入实验室 Phase 1 项目骨架",
  "scripts": {
    "dev:api": "tsx watch api/src/server.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "db:migrate": "tsx api/src/db/migrate.ts",
    "db:prepare-local": "node scripts/prepare-local-db.mjs",
    "typecheck": "tsc -p api/tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit && tsc -p miniprogram/tsconfig.json --noEmit",
    "build:api": "tsc -p api/tsconfig.json",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build": "npm run typecheck && npm run build:api && npm run build:admin",
    "test": "tsx --test api/test/*.test.ts",
    "test:db": "tsx --test api/test/db.integration.ts",
    "test:catalog": "tsx --test api/test/catalog.integration.ts",
    "test:orders": "tsx --test api/test/orders.integration.ts",
    "test:flow": "tsx --test api/test/flow.integration.ts",
    "test:experiments": "tsx --test api/test/experiments.integration.ts",
    "verify:local": "npm run db:migrate && npm test && npm run test:db && npm run test:catalog && npm run test:orders && npm run test:flow && npm run test:experiments && npm run build",
    "start:api": "node dist/api/server.js"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "mysql2": "^3.14.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
