# 仅供本地开发。复制为 .env 后填写，不要提交真实密码或密钥。
API_PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wechat_poi_lab
DB_USER=poi_lab
DB_PASSWORD=replace_with_local_password

# Phase 2：从真实小程序后台获取。Secret 只配置在后端 .env 中。
WECHAT_APPID=
WECHAT_SECRET=

# 本地后台管理员登录密码。请使用随机强密码，不要提交真实值。
ADMIN_PASSWORD=replace_with_local_admin_password

# Phase 5+：真实商户自己的微信支付参数；只放在后端。
WECHAT_MCHID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_SERIAL_NO=
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=
WECHAT_NOTIFY_URL=
