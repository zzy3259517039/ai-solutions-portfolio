<view class="page">
  <view wx:if="{{order}}" class="card">
    <view class="title">{{order.product_name}}</view>
    <view class="row">数量：{{order.quantity}}</view>
    <view class="row">订单号：{{order.order_no}}</view>
    <view class="row">状态：{{order.status}}</view>
    <view class="amount">应付 ¥{{amountYuan}}</view>
    <button wx:if="{{order.status === 'PENDING'}}" bindtap="onPay">微信支付</button>
    <button wx:if="{{order.status === 'PAID'}}" bindtap="onVouchers">查看核销券</button>
    <button wx:if="{{order.status === 'PAID'}}" bindtap="onRefundRequest">申请退款</button>
    <button wx:if="{{order.status === 'PENDING'}}" bindtap="onRefreshPayment">核对支付结果</button>
    <button wx:if="{{order.status === 'PENDING'}}" class="cancel" bindtap="onCancel">取消订单</button>
  </view>
  <view wx:if="{{message}}" class="message">{{message}}</view>
</view>
