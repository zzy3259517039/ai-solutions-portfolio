<view class="page">
  <view wx:for="{{orders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="onOpenOrder">
    <view class="title">{{item.product_name}}</view>
    <view>订单号：{{item.order_no}}</view>
    <view>数量：{{item.quantity}} · ¥{{item.amountYuan}}</view>
    <view>状态：{{item.display_status}}</view>
    <view class="open">查看订单与核销券 ›</view>
  </view>
  <view wx:if="{{message}}" class="message">{{message}}</view>
</view>
